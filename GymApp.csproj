<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <!-- The test project lives under this project's directory, so exclude it from the
       default **/*.cs glob — otherwise GymApp tries to compile the test files itself. -->
  <ItemGroup>
    <Compile Remove="GymApp.Tests\**" />
    <None Remove="GymApp.Tests\**" />
    <EmbeddedResource Remove="GymApp.Tests\**" />
  </ItemGroup>

</Project>
